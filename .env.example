# Copy to .env.local and fill in your own keys. NEVER commit real values.
# Multiple keys per provider enable automatic rotation past rate limits.

# LLM providers (news severity extraction) — at least one required
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
MISTRAL_API_KEY=
MISTRAL_API_KEY_2=
MISTRAL_API_KEY_3=
CEREBRAS_API_KEY=
CEREBRAS_API_KEY_2=
CEREBRAS_API_KEY_3=

# News ingestion
NEWSAPI_KEY=

# TabPFN hosted inference (optional; the tabpfn-client model)
TABPFN_TOKEN=
